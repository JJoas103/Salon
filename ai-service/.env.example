# ai-service 환경설정 — 복사해서 .env 로 쓸 것 (.env 는 커밋되지 않음)
#
# 아무것도 안 건드리면 로컬 Ollama(qwen3.5:9b)로 동작함
# 아래 항목은 전부 선택 — 필요한 줄만 # 를 지워서 씀

# 1) GPT 로 바꿀 때 — pip install langchain-openai 가 먼저 필요함
#    LLM_PROVIDER 가 openai 면 Ollama 쪽은 아예 호출되지 않음
#LLM_PROVIDER=openai
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# 2) 원격 스위치 — 다른 PC 의 Ollama 로 추론을 넘길 때만 주소를 바꿈
#OLLAMA_BASE_URL=http://localhost:11434

# 3) 모델 교체
#OLLAMA_MODEL=qwen3.5:9b

# 아래 둘은 기본값이 localhost 라 보통 건드릴 일이 없음
#ELASTICSEARCH_URL=http://localhost:9200
#SPRING_SERVICES_URL=http://localhost:8080/api/services

# 4) 이미지 편집 — 기본값 none 이면 기능 자체가 꺼짐(스프링도 메뉴를 안 그림)
#    LLM_PROVIDER 와 별개임. 상담을 GPT 로 바꿔도 이미지는 여기 값만 따라감
#    Ollama 는 이미지를 생성하지 못해 상담 모델로는 대체되지 않음
#IMAGE_PROVIDER=openai
#OPENAI_IMAGE_MODEL=gpt-5.4-mini
#OPENAI_IMAGE_QUALITY=low

# 5) 로컬 이미지 — stable-diffusion.cpp 의 sd-server 를 띄워놓고 쓸 때
#    6800XT/Vulkan 실측으로 512 편집이 22~26초, VRAM 4.7GB
#    해상도를 올리면 급격히 느려짐(1024 는 163초) — 바꾸려면 다시 재고 바꿀 것
#
#    서버는 --diffusion-fa --offload-to-cpu 로 띄울 것
#    512/4스텝에서는 offload 대가가 0 이면서 VRAM 만 2.9GB 줄어 상담 모델과 공존됨
#    기본 바인딩이 127.0.0.1 이라 다른 PC 에서 붙으려면 -l 로 주소를 열어야 하는데,
#    sd-server 에는 인증이 없으므로 LAN 에 그대로 열지 말 것
#    sd-server 는 stdin 이 EOF 면 리슨 직후 조용히 죽음 — 서비스로 등록하면 stdin 을 열어둘 것
#IMAGE_PROVIDER=sdcpp
#SDCPP_BASE_URL=http://192.168.1.23:1234
#SDCPP_IMAGE_EDGE=512
#SDCPP_STEPS=4
#    상담 모델과 공존이 안 될 때만 1 — 이미지 차례에 Ollama 를 내림
#SDCPP_UNLOAD_CHAT=0
