# ai-service 환경설정 — 복사해서 .env 로 쓸 것 (.env 는 커밋되지 않음)
# 필요한 줄만 # 를 지워서 씀


# 1) 상담 — openai 면 Ollama 는 호출되지 않음
#LLM_PROVIDER=openai
#OPENAI_MODEL=gpt-5-nano

# 상담과 이미지가 같은 키를 씀
#OPENAI_API_KEY=


# 2) 다른 PC 의 Ollama 를 쓰거나 모델을 바꿀 때
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_MODEL=qwen3.5:9b


# 3) 기본값이 localhost 라 보통 건드릴 일이 없음
#ELASTICSEARCH_URL=http://localhost:9200
#SPRING_SERVICES_URL=http://localhost:8080/api/services


# 4) 이미지 — none 이면 기능이 꺼짐. LLM_PROVIDER 와 별개로 움직임
#IMAGE_PROVIDER=openai
#OPENAI_IMAGE_MODEL=gpt-5-nano
#OPENAI_IMAGE_QUALITY=low

# sd-server(stable-diffusion.cpp)를 미리 띄워둬야 함
# --diffusion-fa --offload-to-cpu 로 띄워야 상담 모델과 VRAM 을 나눠 씀
# 인증이 없으므로 LAN 에 그대로 열지 말 것
#IMAGE_PROVIDER=sdcpp
#SDCPP_BASE_URL=http://192.168.1.23:8188
#SDCPP_IMAGE_EDGE=512
#SDCPP_STEPS=4

# 공존이 안 될 때만 1 — 이미지 차례에 Ollama 를 내림
#SDCPP_UNLOAD_CHAT=0
