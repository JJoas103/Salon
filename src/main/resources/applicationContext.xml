<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/tx
                           http://www.springframework.org/schema/tx/spring-tx.xsd">

    <!-- 접속정보 파일 로딩. oauth2.properties는 커밋되지 않는 로컬 파일이라 없을 수 있으므로
         ignore-resource-not-found 로 없어도 뜨게 한다 (payment.properties와 동일한 이유).
         반드시 하나의 property-placeholder에서 같이 로딩해야 한다 — 별도 placeholder로 나누면
         먼저 처리되는 쪽이 "${...:기본값}" 플레이스홀더를 자기 프로퍼티에 없다는 이유로 기본값으로
         먼저 확정시켜버려서, 나중 placeholder가 실제 값을 읽어도 이미 반영이 안 되는 문제가 있었다.
         SecurityConfig가 root/web 두 컨텍스트 모두에서 스캔되므로 이 파일도 양쪽에 등록한다. -->
    <context:property-placeholder location="classpath:properties/db.properties,classpath:properties/app.properties,classpath:properties/oauth2.properties,classpath:properties/payment.properties" ignore-resource-not-found="true" />


    <!-- service / mapper 패키지 스캔 (controller 는 dispatcher 가 스캔) -->
    <context:component-scan base-package="com.soldesk.config, com.soldesk.security, com.soldesk.es">

    </context:component-scan>


    <!-- ① DataSource : DB 연결 정보 (참고 프로젝트와 동일한 DriverManagerDataSource) -->
    <bean id="dataSource"
          class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="${db.driver}" />
        <property name="url" value="${db.url}" />
        <property name="username" value="${db.username}" />
        <property name="password" value="${db.password}" />
    </bean>

    <!-- ② SqlSessionFactory : MyBatis 핵심, mapper XML 파싱 -->
    <bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <property name="dataSource" ref="dataSource" />
        <property name="mapperLocations" value="classpath*:mapper/*.xml" />
        <!-- VO 클래스를 별칭으로 (mapper XML 에서 짧게 참조) -->
        <property name="typeAliasesPackage" value="com.soldesk.vo" />
    </bean>

    <!-- ③ MapperScannerConfigurer : com.soldesk.mapper 인터페이스 자동 구현 -->
    <bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <property name="basePackage" value="com.soldesk.mapper" />
        <property name="sqlSessionFactoryBeanName" value="sqlSessionFactory" />
    </bean>

    <!-- ④ 트랜잭션 매니저 + @Transactional 활성화 -->
    <bean id="transactionManager"
          class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
        <property name="dataSource" ref="dataSource" />
    </bean>
    <tx:annotation-driven transaction-manager="transactionManager" />

</beans>
