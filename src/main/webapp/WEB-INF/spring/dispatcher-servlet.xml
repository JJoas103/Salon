<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/mvc
                           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- @Controller, @RequestMapping 등 활성화 -->
    <mvc:annotation-driven />

    <!-- 접속정보 파일 로딩 -->
    <!-- payment.properties 는 커밋되지 않는 로컬 파일이라 아직 없을 수 있다.
         ignore-resource-not-found 로 없어도 뜨게 하고, 값이 비었을 때는
         KakaoPayService 가 결제 시점에 안내 메시지로 막는다. -->
    <context:property-placeholder
        location="classpath:properties/db.properties,classpath:properties/app.properties,classpath:properties/payment.properties"
        ignore-resource-not-found="true" />


    <!-- 컴포넌트 스캔.
         com.soldesk.ws(WebSocketConfig)는 반드시 여기(웹 컨텍스트)에서만 스캔한다.
         @EnableWebSocketMessageBroker 가 만드는 메시지 핸들러는 @MessageMapping 을 찾을 때
         자기 컨텍스트의 빈만 훑으므로(조상 미포함), 루트에 두면 controller 의
         @MessageMapping 이 아무 예외 없이 조용히 무시된다. -->
    <context:component-scan base-package="com.soldesk.controller,
                                            com.soldesk.service,
                                            com.soldesk.config,
                                            com.soldesk.validation,
                                            com.soldesk.handler,
                                            com.soldesk.ws" />

    <!-- ViewResolver : "home" -> /WEB-INF/views/home.jsp -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/" />
        <property name="suffix" value=".jsp" />
    </bean>

    <!-- 정적 리소스 : /resources/** -> webapp/resources/ -->
    <mvc:resources mapping="/resources/**" location="/resources/" />
    <!-- 업로드 파일 : /upload/** -> app.properties 의 upload.path (webapp 바깥) -->
    <mvc:resources mapping="/upload/**" location="file:${upload.path}/" />

    <!-- 파일 업로드(multipart/form-data) 처리.
         빈 이름은 반드시 "multipartResolver" — DispatcherServlet이 이 이름으로 찾는다.
         이 빈이 없으면 요청이 MultipartHttpServletRequest로 감싸이지 않아
         @ModelAttribute 바인딩 시 텍스트 필드까지 Part 객체로 들어가 400(BindException)이 난다.
         용량 제한은 web.xml의 <multipart-config>를 따른다. -->
    <bean id="multipartResolver"
          class="org.springframework.web.multipart.support.StandardServletMultipartResolver" />
</beans>
